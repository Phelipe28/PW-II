<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <title>Formulário Express + EJS</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    
</head>

<body>

    <form action="/enviarContato" method="POST">

        <h1>Formulário</h1>
        <div>
            
            <input type="text" id="nome" name="nome" placeholder="Nome" required>
        </div>

        <div>
            
            <input type="text" id="email" name="email" placeholder="E-mail" required>
        </div>

        <div >
            
            <input type="date" id="nascimento" name="nascimento">
        </div>

        <div>
            
            <select name="estado" id="estado">
                <option value="SP"> SP </option>
                <option value="RJ"> RJ </option>
                <option value="MG"> MG </option>
                <option value="ES"> ES </option>
                <option value="AC"> AC </option>
                <option value="AP"> AP </option>
                <option value="AM"> AM </option>
                <option value="PA"> PA </option>
                <option value="RO"> RO </option>
                <option value="TO"> TO </option>
                <option value="RR"> RR </option>
                <option value="AL"> AL </option>
                <option value="BA"> BA </option>
                <option value="CE"> CE </option>
                <option value="MA"> MA </option>
                <option value="PB"> PB </option>
                <option value="PE"> PE </option>
                <option value="PI"> PI </option>
                <option value="RN"> RN </option>
                <option value="SE"> SE </option>
                <option value="GO"> GO </option>
                <option value="MT"> MT </option>
                <option value="MS"> MS </option>
                <option value="DF"> DF </option>
                <option value="PR"> PR </option>
                <option value="RS"> RS</option>
                <option value="SC"> SC </option>

            </select>
        </div>

        <div class="sexo">
            <label for="masculino">Masculino</label>
            <input type="radio" name="genero" id="masculino" value="Masculino">

            <label for="feminino">Feminino</label>
            <input type="radio" name="genero" id="feminino" value="Feminino">
        </div>

        <div>
            <select name="estadoCivil" id="estadoCivil">
                <option value="Solteiro"> Solteiro </option>
                <option value="Casado"> Casado </option>
                <option value="Divorciado"> Divorciado </option>
                <option value="Viuvo"> Viúvo </option>
                <option value="Separado"> Separado </option>
            </select>
        </div>

        <div>
            
            <input type="text" id="cep" name="cep" placeholder="CEP" required>
        </div>

        <div>
            
            <input type="text" id="logra" name="logra" placeholder="Logradouro" required>
        </div>

        <div>
            
            <input type="number" id="numero" name="numero" placeholder="Numero de Telefone" required>
        </div>

        <div>
           
            <input type="text" id="cidade" name="cidade" placeholder="Cidade" required>
        </div>

        <div>
            
            <input type="text" id="complemento" name="complemento" placeholder="Complemento" required>
        </div>

        <div>
            
            <input type="text" id="cpf" name="cpf" placeholder="CPF" required>
        </div>


        <div>
            
            <input type="text" id="rg" name="rg" placeholder="RG" required>
        </div>


        <button type="submit">Enviar</button>
    </form>

    <div class="resut">
        <h1>Dados</h1>
        <p>
            <%= nome %>
        </p>
        <p>
            <%= email %>
        </p>
        <p>
            <%= nascimento %>
        </p>
        <p>
            <%= estado %>
        </p>
        <p>
            <%= genero %>
        </p>
        <p>
            <%= estadoCivil %>
        </p>
        <p>
            <%= cep %>
        </p>
        <p>
            <%= logra %>
        </p>
        <p>
            <%= numero %>
        </p>
        <p>
            <%=cidade %>
        </p>
        <p>
            <%=complemento %>
        </p>
        <p>
            <%=cpf %>
        </p>
        <p>
            <%=rg %>
        </p>
    </div>
</body>

</html>